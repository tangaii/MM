# Include the small experiment logs excluded by the repository's root rules.
!*.log

# Model states, cached tensors, binary arrays, and downloaded documents.
*.pt
*.pth
*.ckpt
*.pkl
*.pickle
*.npy
*.npz
*.bin
*.safetensors
*.onnx
*.mat
*.h5
*.hdf5
*.pdf

# Archives, interrupted atomic writes, and local runtime locks.
*.zip
*.tar
*.tar.*
*.gz
*.7z
*.lock
*.tmp
*.tmp.*

# Python build artifacts.
__pycache__/
*.pyc
*.pyo
